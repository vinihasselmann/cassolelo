# Copie para spikes/.env e preencha. Nunca versione o .env.

# Credenciais do app APS (liberado em Custom Integrations do ACC)
APS_CLIENT_ID=
APS_CLIENT_SECRET=

# Região dos dados no ACC: US (padrão), EMEA ou AUS
APS_REGION=US

# Nomes do parâmetro de marca, em ordem de preferência (padrão: Marca,Mark)
MARK_PROPERTY_NAMES=Marca,Mark

# Nomes de propriedade usados como categoria (fallback: categoria da árvore do modelo)
CATEGORY_PROPERTY_NAMES=Category,Categoria,IfcClass

# Propriedades de dimensão comparadas dentro de uma mesma marca (0.3)
DIMENSION_PROPERTY_NAMES=Comprimento,Largura,Altura,Length,Width,Height

# Secret para assinatura dos webhooks (0.5). Gere um valor aleatório longo.
APS_WEBHOOK_SECRET=
