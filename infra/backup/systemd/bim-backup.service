# Backup do Visualizador BIM (10.3). Copie para /etc/systemd/system/ junto com o .timer.
# Ajuste WorkingDirectory para onde o repositório foi instalado.
[Unit]
Description=Backup diário do PostgreSQL do Visualizador BIM
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/visualizador-bim
ExecStart=/usr/bin/docker compose -f infra/docker-compose.prod.yml --env-file infra/.env.prod --profile backup run --rm backup
TimeoutStartSec=2h
