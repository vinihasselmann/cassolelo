# Copie para infra/.env (o `make dev` faz isso na primeira vez). Nunca versione o .env.

# dev | test | staging | prod  (o usuário simulado X-Dev-User só funciona em dev)
APP_ENV=dev
LOG_LEVEL=INFO

# Login Microsoft (Fase 11, docs/LOGIN.md). Em dev é opcional: sem eles o app abre
# direto com o usuário simulado; com eles, a tela de entrada oferece os dois.
# Redirect URI do registro: http://localhost:5173
ENTRA_CLIENT_ID=
ENTRA_TENANT_ID=
ENTRA_API_SCOPE=
ALLOWED_EMAIL_DOMAINS=cassol.ind.br
BOOTSTRAP_ADMIN_EMAILS=vhbastos@cassol.ind.br
ENTRA_ROLE_GROUPS=

# PostgreSQL 16 (docker compose)
POSTGRES_USER=bim
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=bim
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://bim:troque-esta-senha@127.0.0.1:5432/bim

# Redis 7 (docker compose)
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0

# APS (somente backend). Escopos usados: data:read viewables:read
APS_CLIENT_ID=
APS_CLIENT_SECRET=
APS_REGION=US

# Nomes do parâmetro de marca no modelo, em ordem de preferência (PADRÃO: cada obra pode
# ter a sua regra na aba "Identificação das peças")
MARK_PROPERTY_NAMES=Marca,Mark
# Propriedade de categoria, em ordem de preferência (sem nenhuma: categoria da árvore do modelo)
CATEGORY_PROPERTY_NAMES=Category,Categoria,IfcClass
# Montagens (.nwd/.rvt com vínculos): categorias do corpo da peça, sugeridas ao ligar o
# modo montagens numa obra (aba Identificação das peças)
PIECE_CATEGORY_NAMES=Pilares estruturais,Quadro estrutural
# Validação de marcas: dimensões comparadas entre peças da mesma marca e categoria
# IFC (montagens): só NetVolume; Length/Width/Height do IFC vêm com eixos trocados em parte das peças
# Coordenadas do eixo da peça: ponto por tipo (Pilar: base|topo; Viga: meia altura|face
# inferior|face superior; Laje: face inferior|face superior)
AXIS_Z_RULE=Pilar=base;Viga=meia altura;Laje=face inferior
DIMENSION_PROPERTY_NAMES=SEÇÃO-Altura,SEÇÃO-Largura,PEÇA-Comprimento,Comprimento,Largura,Altura,NetVolume
DIMENSION_TOLERANCE_MM=5
# Reconciliação (Fase 7): propriedades (além das dimensões acima) cuja mudança entre
# versões manda a marca para "revisar". Padrão: só o tipo; acrescentar outras conforme o uso
# (ex.: TECNOLOGIA-Aço). Nada aqui é obrigatório no modelo.
REVIEW_PROPERTY_NAMES=Nome do tipo,Type Name,ObjectType
# Filtros salvos e esquemas de cores compartilhados: papéis que criam/editam/excluem
SHARED_FILTER_ROLES=fabrica,admin
# Busca: propriedade de nível e propriedades cujos valores entram na busca livre (tipo, seção...)
LEVEL_PROPERTY_NAMES=Nível,Level,Nível base,Base Level,Nível de referência,Reference Level,Restrição da base,Base Constraint,IfcSpatialContainer
SEARCH_PROPERTY_NAMES=Tipo,Type,Type Name,Nome do tipo,Família e tipo,Family and Type,Família,Family,Seção,Section,Material estrutural,Structural Material,ObjectType

# Webhooks APS (Fase 2.3). Secret: valor aleatório longo; registre com
#   cd backend && uv run python -m app.cli hooks set-secret
APS_WEBHOOK_SECRET=
# URL pública do backend (ex.: túnel https://abc.trycloudflare.com). Com ela, os hooks são
# registrados automaticamente ao criar uma obra.
PUBLIC_BASE_URL=
# Tempo real (Fase 8): heartbeat do SSE /api/obras/{id}/events (segundos)
SSE_HEARTBEAT_SECONDS=20
# Fuso das datas mostradas/exportadas (Excel)
DISPLAY_TIMEZONE=America/Sao_Paulo
# ---------------------------------------------------------------- Observabilidade (Fase 10)
# Logs: json (uma linha por evento) ou text
LOG_FORMAT=json
# GET /api/metrics para coletores: Authorization: Bearer <METRICS_TOKEN> (admin também acessa)
METRICS_TOKEN=
# Alertas (versão failed, sem conversão > 2 h, webhooks parados, credenciais APS 401/403)
# Teams: URL do fluxo "Post to a channel when a webhook request is received" (Workflows)
ALERT_TEAMS_WEBHOOK_URL=
# E-mail: destinatários separados por vírgula + servidor SMTP
ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
# Endereço do app, para links nos alertas
APP_BASE_URL=

# ---------------------------------------------------------------- Segurança (Fase 10.2)
# CORS: origens permitidas (vírgulas). Vazio = só a origem de APP_BASE_URL fora de dev.
# "*" é recusado. Em dev o Vite repassa /api (mesma origem) e nada precisa ser liberado.
CORS_ORIGINS=
# HSTS (só fora de dev), em segundos; 0 desliga
HSTS_MAX_AGE=31536000
# Escritas (POST/PUT/PATCH/DELETE) por usuário por minuto; 0 desliga. Acima: 429 + Retry-After
RATE_LIMIT_WRITES_PER_MIN=120
