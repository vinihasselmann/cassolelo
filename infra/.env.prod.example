# Visualizador BIM — variáveis da pilha de produção/teste (docker-compose.prod.yml).
# Copie para infra/.env.prod. NÃO coloque segredos aqui: eles ficam em infra/secrets/
# (um arquivo por segredo; ver docs/DEPLOY.md). Descrição de cada variável no DEPLOY.md.

# ------------------------------------------------------------------ ambiente
# staging = ambiente de teste com a fábrica · prod = definitivo (login obrigatório)
# Os dois usam o login Microsoft (Fase 11, docs/LOGIN.md) e exigem HTTPS.
APP_ENV=staging
APP_VERSION=local
COMPOSE_PROJECT_NAME=visualizador-bim-prod
LOG_LEVEL=INFO
LOG_FORMAT=json

# ------------------------------------------------------------------ login Microsoft
# Registro do app no Entra ID feito pela TI (docs/LOGIN.md). Não são segredos.
ENTRA_CLIENT_ID=
ENTRA_TENANT_ID=
# vazio = api://<ENTRA_CLIENT_ID>/access_as_user
ENTRA_API_SCOPE=
ALLOWED_EMAIL_DOMAINS=cassol.ind.br
# sempre admin ao entrar (o primeiro admin não depende da TI)
BOOTSTRAP_ADMIN_EMAILS=vhbastos@cassol.ind.br
# opcional: papel pelo grupo do Entra, ex.: admin=<id>;projetos=<id>;fabrica=<id>
ENTRA_ROLE_GROUPS=

# ------------------------------------------------------------------ rede
# Porta do nginx no servidor. Os tablets acessam http://<ip-ou-nome-do-servidor>:<porta>
HTTP_BIND=0.0.0.0
HTTP_PORT=80
# Endereço que os usuários digitam (links dos alertas; origem do CORS)
APP_BASE_URL=http://servidor-bim
# Mesmo domínio para app e /api (nginx): CORS não é necessário
CORS_ORIGINS=
# HSTS só tem efeito com HTTPS; deixe o padrão
HSTS_MAX_AGE=31536000
RATE_LIMIT_WRITES_PER_MIN=120

# ------------------------------------------------------------------ banco
POSTGRES_USER=bim
POSTGRES_DB=bim
# (a senha fica em infra/secrets/postgres_password e a URL completa em
#  infra/secrets/database_url: postgresql+asyncpg://bim:<senha>@postgres:5432/bim)

# ------------------------------------------------------------------ APS (Autodesk)
APS_CLIENT_ID=
APS_REGION=US
# Sem acesso externo: vazio = webhooks desligados; versões chegam pela verificação a
# cada 10 min e pelo "Sincronizar agora". Com URL pública HTTPS, preencha e rode
#   docker compose ... run --rm api python -m app.cli hooks reregister --all
PUBLIC_BASE_URL=

# ------------------------------------------------------------------ modelo (padrões)
MARK_PROPERTY_NAMES=Marca,Mark

# ------------------------------------------------------------------ alertas
# Canais: Teams (segredo alert_teams_webhook_url) e/ou e-mail (abaixo + smtp_password)
ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_FROM=
SMTP_STARTTLS=true
# Alerta se não houver backup bem-sucedido nesse intervalo (horas); 0 desliga
BACKUP_MAX_AGE_HOURS=26

# ------------------------------------------------------------------ backup
# Pasta local do servidor (caminho do host) onde ficam os dumps (retenção abaixo)
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
# Cópias fora do servidor, separadas por espaço (remotes do rclone em secrets/rclone_conf):
#   pasta compartilhada SMB: "pasta:bim-backups"   SharePoint: "sharepoint:Backups/BIM"
BACKUP_REMOTES=
